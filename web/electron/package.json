{
  "name": "iptvy-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "IPTVy desktop — Electron wrapper that runs the web build's local host in-process",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mshaaban.iptvy",
    "productName": "IPTVy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "preload.cjs"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "web",
        "filter": [
          "app/**/*",
          "api/**/*",
          "dev-server.mjs"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
